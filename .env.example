# API origin used by next.config.ts rewrites (/api/* -> ${NEXT_PUBLIC_API_URL}/*).
# IMPORTANT: Set this to the API origin WITHOUT a trailing /api.
# Example: https://web-production-de080.up.railway.app
NEXT_PUBLIC_API_URL=

# Replace with your Google Tag Manager container ID (format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Server-side key used by /investor-api/codex route handlers.
# This must never be exposed as NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Optional: explicitly set if you use a non-default env variable for Codex auth.
CODEX_API_KEY=

# Optional: override working directory for investor Codex executions.
INVESTOR_CODEX_WORKDIR=

# Optional: comma-separated additional dirs Codex can access.
INVESTOR_CODEX_ADDITIONAL_DIRS=
